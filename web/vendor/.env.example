# Copy this file to .env.local (gitignored) and fill in real values for
# local dev. Next.js loads .env.local automatically; nothing here is
# required to run `npm run dev` — the app works fine with it absent.

# Optional. Enables the Google Maps-powered Business Profile location
# picker (address search via Places Autocomplete, draggable pin) — see
# components/location-picker-google.tsx. Leave unset and the page falls
# back to the free Leaflet/OpenStreetMap picker (components/location-
# picker.tsx) instead.
#
# NEXT_PUBLIC_ vars are inlined into the client bundle at build time, so
# this key is visible in the browser regardless of how it's stored —
# restrict it to your vendor portal's domain(s) via HTTP referrer
# restrictions in Google Cloud Console (APIs & Services > Credentials),
# with the Maps JavaScript API and Places API enabled for the project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
