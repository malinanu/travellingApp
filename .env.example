# Copy to .env and fill in before `docker compose build && docker compose up -d`.
# .env is gitignored — never commit real secrets here.

# External Postgres — this stack does not run its own Postgres container.
# Create the database first: psql -U postgres -c "CREATE DATABASE spotto"
DATABASE_URL=postgres://postgres:password@YOUR_POSTGRES_HOST:5432/spotto?sslmode=disable

# Long random string — used to sign session JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# AES-256 key for encrypting TOTP (2FA) secrets at rest. Must be exactly 32
# raw bytes, base64-encoded — the api container refuses to start without a
# valid one. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Origins allowed to call the API from a browser (no trailing slash, comma-separated).
# If mapping domains through a reverse proxy (see PORTAINER.md step 4a),
# use your real https:// subdomains here instead.
CORS_ORIGINS=http://YOUR_SERVER_IP:3000,http://YOUR_SERVER_IP:3001

# Everything below is optional — leave blank and the api container still
# starts fine (email logs instead of sending, Google sign-in reports
# itself as unconfigured).

# Base URL of the deployed vendor webapp, used to build links embedded in
# emails (invite accept, password reset).
VENDOR_APP_URL=http://YOUR_SERVER_IP:3000

# Public base URL of this API. Traveller password-reset emails link to the
# reset page the API serves at <PUBLIC_API_URL>/reset-password (travellers
# have no web app). Unset: they get the vendor-app link instead.
PUBLIC_API_URL=https://YOUR_API_HOST

# SMTP relay for transactional email (team invites, password reset). Works
# with any SMTP-compatible provider — a Gmail app password, SES SMTP, or
# Mailgun SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Spotto <no-reply@spotto.dev>

# Google OAuth client (console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application). Redirect URL must be
# registered there and point at this server's /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://YOUR_SERVER_IP:8881/auth/google/callback

# Plain API key (console.cloud.google.com > APIs & Services > Credentials >
# API key, NOT an OAuth client), with the Calendar API enabled — powers
# automatic public-holiday closure prompts on the vendor Business Profile
# page. This is a runtime env var for the api container — a restart picks
# up changes, no rebuild needed. Leave blank and it falls back to a bundled
# static Sri Lanka holiday list instead.
GOOGLE_CALENDAR_API_KEY=

# Baked into the vendor/admin webapps AT BUILD TIME (Next.js public env vars
# are compile-time, not runtime) — changing this requires a rebuild, not just
# a restart: `docker compose build vendor admin && docker compose up -d`.
# Note: the api container listens on and publishes 8881 (host and container
# ports match) — see docker-compose.yml's `ports:` for the api service.
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8881

# Same build-time caveat as above. Enables the Google Maps-powered address
# search on the vendor Business Profile location picker and the "Find your
# business" registration step. Can reuse the same Cloud project/key as
# GOOGLE_CALENDAR_API_KEY above (with Maps JavaScript API + Places API also
# enabled) — restrict it to your vendor domain via HTTP referrer
# restrictions in Google Cloud Console, since it's visible in the browser
# bundle. Leave blank and the free Leaflet/OpenStreetMap picker is used
# instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
