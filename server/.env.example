PORT=8080

# All four below are required — the server refuses to start without them
# (see internal/config/config.go). Copy this file to .env and fill in real
# values; .env is gitignored and never committed.

DATABASE_URL=postgres://postgres:admin123@localhost:5432/spotto?sslmode=disable

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars

# AES-256 key for encrypting TOTP (2FA) secrets at rest. Must be exactly 32
# raw bytes, base64-encoded. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
