# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Go
server/.env
server/bin/

# Docker Compose (root) — real secrets/URLs live here, never commit
.env
# Next.js local env overrides (e.g. web/vendor/.env.local) — .env.example
# files are still meant to be committed, this only excludes the *.local ones.
.env*.local

# Flutter / Dart
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties
app/.idea/
*.iml

# OS / editor
.DS_Store
Thumbs.db
*.log

# Prototype build artifacts (2 MB standalone snapshots)
Prototype/upload/
